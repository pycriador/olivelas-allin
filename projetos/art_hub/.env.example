# Supabase — obter em https://supabase.com/dashboard → Project Settings → API
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Supabase (somente servidor — NUNCA exponha ao cliente)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres (direto — para migrations)
# Obter em: Dashboard → Project Settings → Database → Connection string → URI (Transaction mode)
SUPABASE_DB_URL=

# Lovable AI Gateway (somente servidor)
LOVABLE_API_KEY=

# Vite — expostas ao cliente (prefixo VITE_)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
