# ==============================================================================
# OLIVELAS ALL IN — VARIÁVEIS DE AMBIENTE (EXEMPLO SEGURO)
# ==============================================================================
# Copie este arquivo para `.env` na raiz do projeto e preencha com as suas
# credenciais reais do Supabase. NUNCA versione o arquivo `.env` no Git.

# URL e Chave Publishable/Anon do projeto Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_KEY=sb_publishable_sua_chave_aqui
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_aqui
VITE_SUPABASE_ANON_KEY=sb_publishable_sua_chave_aqui

# Conexão direta / Supavisor Pooler para execução de migrations (npm run db:migrate)
db_host=db.seu-projeto.supabase.co
db_pooler_host=aws-1-ca-central-1.pooler.supabase.com
db_port=5432
db_database=postgres
db_user=postgres
db_password=sua_senha_postgres_aqui
